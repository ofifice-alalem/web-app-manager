{
  "name": "desktop-application-host",
  "private": true,
  "version": "0.1.0",
  "description": "Single-application desktop host built with Tauri 2, Vue 3, TypeScript, and Rust.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "deploy:win": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1"
  },
  "dependencies": {
    "@fontsource/tajawal": "^5.3.0",
    "@tauri-apps/api": "^2.2.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
