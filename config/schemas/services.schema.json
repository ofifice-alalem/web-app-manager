{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop Application Host - services.json",
  "type": "object",
  "required": ["services"],
  "additionalProperties": false,
  "properties": {
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "required", "check", "commands"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "check": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "url", "expected_status", "timeout_seconds"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "http" },
                  "url": { "type": "string", "pattern": "^https?://" },
                  "expected_status": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "integer", "minimum": 100, "maximum": 599 }
                  },
                  "timeout_seconds": { "type": "integer", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "required": ["type", "host", "port", "timeout_seconds"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "tcp" },
                  "host": { "type": "string", "minLength": 1 },
                  "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                  "timeout_seconds": { "type": "integer", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "required": ["type", "process_name", "timeout_seconds"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "process" },
                  "process_name": { "type": "string", "minLength": 1 },
                  "timeout_seconds": { "type": "integer", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "required": ["type", "container_name", "timeout_seconds"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "docker" },
                  "container_name": { "type": "string", "minLength": 1 },
                  "timeout_seconds": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          },
          "commands": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": { "$ref": "#/$defs/commandDef" },
              "stop": { "$ref": "#/$defs/commandDef" },
              "restart": { "$ref": "#/$defs/commandDef" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "platformCommand": {
      "type": "object",
      "required": ["executable"],
      "additionalProperties": false,
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" }, "default": [] },
        "working_dir": { "type": ["string", "null"] },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "commandDef": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/platformCommand" },
        {
          "type": "object",
          "required": ["platform_commands"],
          "additionalProperties": false,
          "properties": {
            "platform_commands": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "windows": { "$ref": "#/$defs/platformCommand" },
                "linux": { "$ref": "#/$defs/platformCommand" }
              }
            }
          }
        }
      ]
    }
  }
}
